{
  "log": {
    "loglevel": "info",
    "access": "/opt/cnode/log/access.log",
    "error": "/opt/cnode/log/error.log",
    "logDir": "/opt/cnode/log"
  },
  "workers": 0,
  "limits": {
    "ipBan": {
      "enabled": false,
      "failureLimit": 10,
      "windowSeconds": 60,
      "banSeconds": 180
    }
  },
  "dns": {
    "servers": ["8.8.8.8", "1.1.1.1:53"],
    "timeout": 5,
    "cacheSize": 10240,
    "minTTL": 60,
    "maxTTL": 3600
  },
  "timeouts": {
    "handshake": 60,
    "dial": 10,
    "read": 15,
    "write": 30,
    "connIdle": 300
  },
  "panels": [
    {
      "name": "vmess-panel",
      "type": "V2board",
      "apiHost": "https://your-panel.com",
      "key": "your-api-key-here",
      "nodeIDs": [1, 2, 3],
      "nodeType": "vmess",
      "listenIP": "auto",
      "sendIP": "auto",
      "enableDNS": true,
      "tlsEnable": false,
      "tlsCert": "",
      "tlsKey": ""
    },
    {
      "name": "vmess-tls-panel",
      "type": "V2board",
      "apiHost": "https://your-panel.com",
      "key": "your-api-key-here",
      "nodeIDs": [4, 5],
      "nodeType": "vmess",
      "listenIP": "auto",
      "sendIP": "auto",
      "enableDNS": true,
      "tlsEnable": true,
      "tlsCert": "/opt/cnode/certs/fullchain.pem",
      "tlsKey": "/opt/cnode/certs/privkey.pem"
    },
    {
      "name": "trojan-panel-with-tls",
      "type": "V2board",
      "apiHost": "https://your-panel.com",
      "key": "your-api-key-here",
      "nodeIDs": [10],
      "nodeType": "trojan",
      "listenIP": "auto",
      "sendIP": "auto",
      "enableDNS": true,
      "tlsEnable": true,
      "tlsCert": "/opt/cnode/certs/fullchain.pem",
      "tlsKey": "/opt/cnode/certs/privkey.pem"
    },
    {
      "name": "trojan-panel-self-signed",
      "type": "V2board",
      "apiHost": "https://your-panel.com",
      "key": "your-api-key-here",
      "nodeIDs": [11],
      "nodeType": "trojan",
      "listenIP": "auto",
      "sendIP": "auto",
      "enableDNS": true,
      "tlsEnable": true,
      "tlsCert": "",
      "tlsKey": ""
    },
    {
      "name": "trojan-panel-no-tls",
      "type": "V2board",
      "apiHost": "https://your-panel.com",
      "key": "your-api-key-here",
      "nodeIDs": [12],
      "nodeType": "trojan",
      "listenIP": "auto",
      "sendIP": "auto",
      "enableDNS": true,
      "tlsEnable": false,
      "tlsCert": "",
      "tlsKey": ""
    },
    {
      "name": "anytls-panel-with-tls",
      "type": "V2board",
      "apiHost": "https://your-panel.com",
      "key": "your-api-key-here",
      "nodeIDs": [30],
      "nodeType": "anytls",
      "listenIP": "auto",
      "sendIP": "auto",
      "enableDNS": true,
      "tlsEnable": true,
      "tlsCert": "/opt/cnode/certs/fullchain.pem",
      "tlsKey": "/opt/cnode/certs/privkey.pem"
    }
  ]
}
