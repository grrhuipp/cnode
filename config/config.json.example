{
  "log": {
    "loglevel": "info",
    "access": "/var/log/cnode/access.log",
    "error": "/var/log/cnode/error.log",
    "logDir": "/var/log/cnode"
  },
  "workers": 0,
  "dns": {
    "servers": ["8.8.8.8", "1.1.1.1"],
    "timeout": 5,
    "cacheSize": 10000,
    "minTTL": 60,
    "maxTTL": 3600
  },
  "timeouts": {
    "_comment": "handshake 用于握手阶段的 idle + absolute deadline；read/write 用于独立的读写 deadline，同时更短者也会作为连接 idle timer；idle 用于 UDP/会话生命周期",
    "handshake": 10,
    "dial": 10,
    "read": 15,
    "write": 30,
    "idle": 300
  },
  "panels": [
    {
      "_comment": "VMess - TLS 由外部 nginx/caddy 处理（默认）",
      "Name": "vmess-panel",
      "Type": "V2board",
      "APIHost": "https://your-panel.com",
      "Key": "your-api-key-here",
      "NodeIDs": [1, 2, 3],
      "NodeType": "vmess",
      "ListenIP": "auto",
      "SendIP": "auto",
      "EnableDNS": false,
      "DNSType": "",
      "ProxyProtocol": "auto",
      "TLSEnable": false,
      "TLSCert": "",
      "TLSKey": ""
    },
    {
      "_comment": "VMess - 程序处理 TLS，根据面板下发配置",
      "Name": "vmess-tls-panel",
      "Type": "V2board",
      "APIHost": "https://your-panel.com",
      "Key": "your-api-key-here",
      "NodeIDs": [4, 5],
      "NodeType": "vmess",
      "ListenIP": "auto",
      "SendIP": "auto",
      "EnableDNS": false,
      "DNSType": "",
      "ProxyProtocol": "auto",
      "TLSEnable": true,
      "TLSCert": "/etc/acppnode/certs/fullchain.pem",
      "TLSKey": "/etc/acppnode/certs/privkey.pem"
    },
    {
      "_comment": "Trojan - 程序处理 TLS，使用指定证书",
      "Name": "trojan-panel-with-tls",
      "Type": "V2board",
      "APIHost": "https://your-panel.com",
      "Key": "your-api-key-here",
      "NodeIDs": [10],
      "NodeType": "trojan",
      "ListenIP": "auto",
      "SendIP": "auto",
      "EnableDNS": false,
      "DNSType": "",
      "ProxyProtocol": "auto",
      "TLSEnable": true,
      "TLSCert": "/etc/acppnode/certs/fullchain.pem",
      "TLSKey": "/etc/acppnode/certs/privkey.pem"
    },
    {
      "_comment": "Trojan - 程序处理 TLS，自动生成自签名证书（仅测试用）",
      "Name": "trojan-panel-self-signed",
      "Type": "V2board",
      "APIHost": "https://your-panel.com",
      "Key": "your-api-key-here",
      "NodeIDs": [11],
      "NodeType": "trojan",
      "ListenIP": "auto",
      "SendIP": "auto",
      "EnableDNS": false,
      "DNSType": "",
      "ProxyProtocol": "auto",
      "TLSEnable": true,
      "TLSCert": "",
      "TLSKey": ""
    },
    {
      "_comment": "Trojan - TLS 由外部 nginx/caddy 处理",
      "Name": "trojan-panel-no-tls",
      "Type": "V2board",
      "APIHost": "https://your-panel.com",
      "Key": "your-api-key-here",
      "NodeIDs": [12],
      "NodeType": "trojan",
      "ListenIP": "auto",
      "SendIP": "auto",
      "EnableDNS": false,
      "DNSType": "",
      "ProxyProtocol": "auto",
      "TLSEnable": false,
      "TLSCert": "",
      "TLSKey": ""
    },
    {
      "_comment": "AnyTLS - 程序处理 TLS；AnyTLS 用户密码按 sha256(password) 认证",
      "Name": "anytls-panel-with-tls",
      "Type": "V2board",
      "APIHost": "https://your-panel.com",
      "Key": "your-api-key-here",
      "NodeIDs": [30],
      "NodeType": "anytls",
      "ListenIP": "auto",
      "SendIP": "auto",
      "EnableDNS": false,
      "DNSType": "",
      "ProxyProtocol": "auto",
      "TLSEnable": true,
      "TLSCert": "/etc/acppnode/certs/fullchain.pem",
      "TLSKey": "/etc/acppnode/certs/privkey.pem"
    }
  ]
}
