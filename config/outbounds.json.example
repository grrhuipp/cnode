[
  {
    "tag": "direct",
    "protocol": "freedom",
    "settings": {
      "domainStrategy": "AsIs",
      "redirect": ""
    },
    "sendThrough": "auto"
  },
  {
    "tag": "blackhole",
    "protocol": "blackhole",
    "settings": {
      "response": {
        "type": "http"
      }
    }
  },
  {
    "tag": "proxy-vmess",
    "protocol": "vmess",
    "settings": {
      "vnext": [
        {
          "address": "vmess.example.com",
          "port": 443,
          "users": [
            {
              "id": "b831381d-6324-4d53-ad4f-8cda48b30811",
              "alterId": 0,
              "security": "auto"
            }
          ]
        }
      ]
    },
    "streamSettings": {
      "network": "ws",
      "security": "tls",
      "wsSettings": {
        "path": "/ws",
        "headers": {
          "Host": "vmess.example.com"
        }
      },
      "tlsSettings": {
        "serverName": "vmess.example.com"
      }
    }
  },
  {
    "tag": "proxy-trojan",
    "protocol": "trojan",
    "settings": {
      "servers": [
        {
          "address": "trojan.example.com",
          "port": 443,
          "password": "your-password-here"
        }
      ]
    },
    "streamSettings": {
      "network": "tcp",
      "security": "tls",
      "tlsSettings": {
        "serverName": "trojan.example.com",
        "allowInsecure": false
      }
    }
  },
  {
    "tag": "proxy-vless-xhttp-reality",
    "protocol": "vless",
    "settings": {
      "server": "vless.example.com",
      "server_port": 443,
      "uuid": "b831381d-6324-4d53-ad4f-8cda48b30811",
      "encryption": "none",
      "packetEncoding": "xudp"
    },
    "streamSettings": {
      "network": "xhttp",
      "security": "reality",
      "xhttpSettings": {
        "path": "/xhttp",
        "host": "vless.example.com",
        "mode": "packet-up"
      },
      "realitySettings": {
        "serverName": "vless.example.com",
        "publicKey": "your-reality-public-key",
        "shortId": "0123456789abcdef",
        "fingerprint": "chrome",
        "spiderX": "/"
      }
    }
  },
  {
    "tag": "proxy-vless-xhttp-split",
    "protocol": "vless",
    "settings": {
      "server": "upload.example.com",
      "server_port": 443,
      "uuid": "b831381d-6324-4d53-ad4f-8cda48b30811",
      "encryption": "none",
      "packetEncoding": "xudp"
    },
    "streamSettings": {
      "network": "xhttp",
      "security": "tls",
      "tlsSettings": {
        "serverName": "upload.example.com",
        "alpn": [
          "h2"
        ],
        "allowInsecure": false
      },
      "xhttpSettings": {
        "path": "/xhttp-split",
        "host": "upload.example.com",
        "mode": "auto",
        "extra": {
          "downloadSettings": {
            "address": "download.example.com",
            "port": 443,
            "network": "xhttp",
            "security": "tls",
            "tlsSettings": {
              "serverName": "download.example.com",
              "alpn": [
                "h2"
              ],
              "allowInsecure": false
            },
            "xhttpSettings": {
              "path": "/xhttp-split",
              "host": "download.example.com",
              "mode": "auto"
            }
          }
        }
      }
    }
  },
  {
    "tag": "proxy-ss",
    "protocol": "shadowsocks",
    "settings": {
      "servers": [
        {
          "address": "ss.example.com",
          "port": 8388,
          "method": "aes-256-gcm",
          "password": "your-password-here"
        }
      ]
    }
  },
  {
    "tag": "proxy-anytls",
    "protocol": "anytls",
    "settings": {
      "address": "anytls.example.com",
      "port": 443,
      "password": "your-password-here",
      "idleSessionCheckInterval": 30,
      "idleSessionTimeout": 60,
      "minIdleSession": 0
    },
    "streamSettings": {
      "network": "tcp",
      "security": "tls",
      "tlsSettings": {
        "serverName": "anytls.example.com",
        "allowInsecure": false
      }
    }
  }
]
