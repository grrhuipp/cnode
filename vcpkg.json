{
  "name": "cnode",
  "version-string": "1.0.0",
  "configuration": {
    "overlay-ports": ["cmake/ports"],
    "overlay-triplets": ["cmake/triplets"]
  },
  "dependencies": [
    "asio",
    "boringssl",
    "blake3",
    "concurrentqueue",
    { "name": "mimalloc", "features": ["override"] },
    "nghttp3",
    "ngtcp2",
    "tl-expected",
    "zlib"
  ],
  "features": {
    "tests": {
      "description": "Build CTest-managed GoogleTest unit and E2E tests",
      "dependencies": ["gtest", "nlohmann-json", "libsodium"]
    },
    "io-uring": {
      "description": "Build the optional Asio io_uring backend",
      "dependencies": ["liburing"]
    }
  }
}
