+// SSL_reality_client_hello_cb is called after the ClientHello random and
+// X25519 key share have been generated, but before the ClientHello is sent.
+// |shared_secret| is the X25519 shared secret between the generated client key
+// share and the configured REALITY server public key. |client_hello| is the
+// serialized ClientHello handshake message with a zeroed 32-byte session ID.
+// The callback must write the encrypted 32-byte REALITY session ID to
+// |out_session_id| and return one on success.
+typedef int (*SSL_reality_client_hello_cb)(
+    SSL *ssl, const uint8_t *shared_secret, size_t shared_secret_len,
+    const uint8_t *client_random, size_t client_random_len,
+    const uint8_t *client_hello, size_t client_hello_len,
+    uint8_t *out_session_id, size_t out_session_id_len, void *arg);
+
+// SSL_set_reality_client_hello_cb configures a narrow REALITY client hook on
+// |ssl|. It is only used for REALITY handshakes.
+OPENSSL_EXPORT void SSL_set_reality_client_hello_cb(
+    SSL *ssl, SSL_reality_client_hello_cb cb, void *arg);
+
+// SSL_set1_reality_peer_public_key sets the REALITY server X25519 public key
+// used by |SSL_set_reality_client_hello_cb| to derive the shared secret.
+OPENSSL_EXPORT int SSL_set1_reality_peer_public_key(
+    SSL *ssl, const uint8_t *peer_public_key, size_t peer_public_key_len);
