+static bool ssl_apply_reality_client_hello(SSL_HANDSHAKE *hs) {
+  SSL *const ssl = hs->ssl;
+  if (!ssl->config || !ssl->config->reality_client_hello_cb) {
+    return true;
+  }
+
+  if (hs->selected_ech_config ||
+      ssl->config->reality_peer_public_key.size() != 32) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return false;
+  }
+
+  SSLKeyShare *key_share = nullptr;
+  for (auto &candidate : hs->key_shares) {
+    if (candidate && candidate->GroupID() == SSL_GROUP_X25519) {
+      key_share = candidate.get();
+      break;
+    }
+  }
+  if (key_share == nullptr) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_NO_GROUPS_SPECIFIED);
+    return false;
+  }
+
+  hs->session_id_len = sizeof(hs->session_id);
+  OPENSSL_memset(hs->session_id, 0, hs->session_id_len);
+
+  Array<uint8_t> aad;
+  if (!ssl_build_client_hello(hs, &aad)) {
+    return false;
+  }
+
+  Array<uint8_t> shared_secret;
+  uint8_t alert = SSL_AD_INTERNAL_ERROR;
+  if (!key_share->Finish(
+          &shared_secret,
+          &alert,
+          MakeConstSpan(ssl->config->reality_peer_public_key.data(),
+                        ssl->config->reality_peer_public_key.size()))) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+    return false;
+  }
+
+  uint8_t session_id[SSL_MAX_SSL_SESSION_ID_LENGTH] = {0};
+  if (ssl->config->reality_client_hello_cb(
+          ssl,
+          shared_secret.data(),
+          shared_secret.size(),
+          ssl->s3->client_random,
+          SSL3_RANDOM_SIZE,
+          aad.data(),
+          aad.size(),
+          session_id,
+          sizeof(session_id),
+          ssl->config->reality_client_hello_arg) != 1) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return false;
+  }
+
+  OPENSSL_memcpy(hs->session_id, session_id, sizeof(session_id));
+  hs->session_id_len = sizeof(session_id);
+  return true;
+}
+
+bool ssl_add_client_hello(SSL_HANDSHAKE *hs) {
+  SSL *const ssl = hs->ssl;
+  Array<uint8_t> msg;
+  if (!ssl_build_client_hello(hs, &msg)) {
+    return false;
+  }
   return ssl->method->add_message(ssl, std::move(msg));
 }

