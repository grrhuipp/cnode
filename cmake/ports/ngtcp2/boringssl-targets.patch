diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -230,5 +230,8 @@ endif()
 # BoringSSL (required for libngtcp2_crypto_boringssl)
 if(ENABLE_BORINGSSL)
+  find_package(OpenSSL CONFIG REQUIRED)
+  get_target_property(BORINGSSL_INCLUDE_DIR OpenSSL::Crypto INTERFACE_INCLUDE_DIRECTORIES)
+  set(BORINGSSL_LIBRARIES OpenSSL::SSL)
   cmake_push_check_state()
   set(CMAKE_REQUIRED_INCLUDES   "${BORINGSSL_INCLUDE_DIR}")
   set(CMAKE_REQUIRED_LIBRARIES  "${BORINGSSL_LIBRARIES}")
diff --git a/crypto/boringssl/CMakeLists.txt b/crypto/boringssl/CMakeLists.txt
--- a/crypto/boringssl/CMakeLists.txt
+++ b/crypto/boringssl/CMakeLists.txt
@@ -58,10 +58,14 @@ if(ENABLE_STATIC_LIB)
   )
   target_compile_definitions(ngtcp2_crypto_boringssl_static PUBLIC
     "-DNGTCP2_STATICLIB")
-  target_include_directories(ngtcp2_crypto_boringssl_static PUBLIC
-    ${ngtcp2_crypto_boringssl_INCLUDE_DIRS})
+  target_include_directories(ngtcp2_crypto_boringssl_static
+    PRIVATE ${ngtcp2_crypto_boringssl_INCLUDE_DIRS}
+    PUBLIC "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>")
+  target_link_libraries(ngtcp2_crypto_boringssl_static PUBLIC
+    ngtcp2_static OpenSSL::SSL)
 
   install(TARGETS ngtcp2_crypto_boringssl_static
+    EXPORT ngtcp2Targets
     DESTINATION "${CMAKE_INSTALL_LIBDIR}")
 endif()
 
diff --git a/lib/config.cmake.in b/lib/config.cmake.in
--- a/lib/config.cmake.in
+++ b/lib/config.cmake.in
@@ -1,4 +1,7 @@
 include(CMakeFindDependencyMacro)
+if("@ENABLE_BORINGSSL@")
+    find_dependency(OpenSSL CONFIG)
+endif()
 if("@HAVE_OSSL@")
     find_dependency(OpenSSL)
 endif()
