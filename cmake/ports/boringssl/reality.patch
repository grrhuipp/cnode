+void SSL_CTX_set_reality_ignore_peer_signature_algorithm_prefs(SSL_CTX *ctx,
+                                                               int enabled) {
+  FromOpaque(ctx)->cert->reality_ignore_peer_signature_algorithm_prefs =
+      enabled != 0;
+}
+
+void SSL_set_reality_ignore_peer_signature_algorithm_prefs(SSL *ssl,
+                                                           int enabled) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (ssl_impl->config) {
+    ssl_impl->config->cert->reality_ignore_peer_signature_algorithm_prefs =
+        enabled != 0;
+  }
+}
+
+void SSL_set_reality_client_hello_cb(SSL *ssl, SSL_reality_client_hello_cb cb,
+                                     void *arg) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (ssl_impl->config) {
+    ssl_impl->config->reality_client_hello_cb = cb;
+    ssl_impl->config->reality_client_hello_arg = arg;
+  }
+}
+
+int SSL_set1_reality_peer_public_key(SSL *ssl, const uint8_t *peer_public_key,
+                                     size_t peer_public_key_len) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config || peer_public_key == nullptr ||
+      peer_public_key_len != 32) {
+    return 0;
+  }
+  return ssl_impl->config->reality_peer_public_key.CopyFrom(
+      Span(peer_public_key, peer_public_key_len));
+}
