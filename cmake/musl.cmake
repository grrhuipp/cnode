set(CNODE_MUSL_ROOT "$ENV{CNODE_MUSL_ROOT}" CACHE PATH "LLVM musl toolchain root")
if(NOT CNODE_MUSL_ROOT)
    find_program(CNODE_MISE_EXECUTABLE mise REQUIRED)
    execute_process(COMMAND "${CNODE_MISE_EXECUTABLE}" where github:cross-tools/clang-cross
        OUTPUT_VARIABLE CNODE_MUSL_ROOT OUTPUT_STRIP_TRAILING_WHITESPACE
        COMMAND_ERROR_IS_FATAL ANY)
    string(APPEND CNODE_MUSL_ROOT "/x86_64-unknown-linux-musl")
endif()
if(NOT EXISTS "${CNODE_MUSL_ROOT}/bin/x86_64-unknown-linux-musl-clang++")
    message(FATAL_ERROR "Run mise install, or set CNODE_MUSL_ROOT to the LLVM musl toolchain")
endif()
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CNODE_TARGET_IS_MUSL ON CACHE INTERNAL "musl-only target toolchain")
# The wrappers also carry target/sysroot into non-CMake vcpkg ports.
set(CMAKE_C_COMPILER "${CNODE_MUSL_ROOT}/bin/x86_64-unknown-linux-musl-clang")
set(CMAKE_CXX_COMPILER "${CNODE_MUSL_ROOT}/bin/x86_64-unknown-linux-musl-clang++")
set(CMAKE_C_COMPILER_TARGET x86_64-unknown-linux-musl)
set(CMAKE_CXX_COMPILER_TARGET x86_64-unknown-linux-musl)
set(CMAKE_SYSROOT "${CNODE_MUSL_ROOT}/x86_64-unknown-linux-musl/sysroot")
set(CMAKE_AR "${CNODE_MUSL_ROOT}/bin/llvm-ar")
set(CMAKE_RANLIB "${CNODE_MUSL_ROOT}/bin/llvm-ranlib")
foreach(language IN ITEMS C CXX)
    set(CMAKE_${language}_COMPILER_AR "${CMAKE_AR}")
    set(CMAKE_${language}_COMPILER_RANLIB "${CMAKE_RANLIB}")
endforeach()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CNODE_MUSL_ROOT VCPKG_C_FLAGS VCPKG_CXX_FLAGS)
set(CMAKE_C_FLAGS_INIT "${VCPKG_C_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${VCPKG_CXX_FLAGS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -static")
# vcpkg's autotools adapter also uses the shared-link flags for executable probes.
# All target dependencies are static, including those non-CMake probe binaries.
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld -static")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=lld -static")
