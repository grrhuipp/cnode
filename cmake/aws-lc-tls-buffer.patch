 #include "../crypto/internal.h"
 #include "internal.h"
 
+// cnode_set_tls_buffer_allocator: connection read/write buffers only.
+// SSL_CTX and the session cache stay on the system allocator.
+static void *(*g_cnode_tls_buffer_alloc)(size_t) = nullptr;
+static void (*g_cnode_tls_buffer_free)(void *) = nullptr;
+
+extern "C" void cnode_set_tls_buffer_allocator(
+    void *(*alloc_fn)(size_t), void (*free_fn)(void *)) {
+  g_cnode_tls_buffer_alloc = alloc_fn;
+  g_cnode_tls_buffer_free = free_fn;
+}
+
+static uint8_t *CnodeTlsBufferAlloc(size_t size) {
+  if (g_cnode_tls_buffer_alloc != nullptr) {
+    return static_cast<uint8_t *>(g_cnode_tls_buffer_alloc(size));
+  }
+  return static_cast<uint8_t *>(malloc(size));
+}
+
+static void CnodeTlsBufferFree(void *ptr) {
+  if (ptr == nullptr) {
+    return;
+  }
+  if (g_cnode_tls_buffer_free != nullptr) {
+    g_cnode_tls_buffer_free(ptr);
+    return;
+  }
+  free(ptr);
+}
 
