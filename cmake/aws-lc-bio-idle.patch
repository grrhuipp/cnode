diff --git a/crypto/bio/pair.c b/crypto/bio/pair.c
--- a/crypto/bio/pair.c
+++ b/crypto/bio/pair.c
@@ -63,13 +63,11 @@ static void bio_destroy_pair(BIO *bio) {
 
   peer_b->peer = NULL;
   peer_bio->init = 0;
-  assert(peer_b->buf != NULL);
   peer_b->len = 0;
   peer_b->offset = 0;
 
   b->peer = NULL;
   bio->init = 0;
-  assert(b->buf != NULL);
   b->len = 0;
   b->offset = 0;
 }
@@ -105,7 +103,7 @@ static int bio_read(BIO *bio, char *buf, int size_) {
   assert(b->peer != NULL);
   peer_b = b->peer->ptr;
   assert(peer_b != NULL);
-  assert(peer_b->buf != NULL);
+  assert(peer_b->len == 0 || peer_b->buf != NULL);
 
   peer_b->request = 0;  // will be set in "retry_read" situation
 
@@ -187,7 +185,6 @@ static int bio_write(BIO *bio, const char *buf, int num_) {
   b = bio->ptr;
   assert(b != NULL);
   assert(b->peer != NULL);
-  assert(b->buf != NULL);
 
   b->request = 0;
   if (b->closed) {
@@ -196,6 +193,18 @@ static int bio_write(BIO *bio, const char *buf, int num_) {
     return -1;
   }
 
+  // The idle cnode transport can release an empty ring without changing
+  // its 17 KiB capacity. Recreate it only when the next write arrives.
+  if (b->buf == NULL) {
+    assert(b->len == 0);
+    b->buf = OPENSSL_malloc(b->size);
+    if (b->buf == NULL) {
+      OPENSSL_PUT_ERROR(BIO, ERR_R_MALLOC_FAILURE);
+      return -1;
+    }
+    b->offset = 0;
+  }
+
   assert(b->len <= b->size);
 
   if (b->len == b->size) {
@@ -423,6 +432,37 @@ int BIO_destroy_bio_pair(BIO *b) {
   return 1;
 }
 
+// Called only from the connection's owning Worker while the TLS read is
+// parked. The pair remains connected and retains its original capacities.
+OPENSSL_EXPORT int cnode_release_empty_bio_pair_buffers(BIO *bio);
+int cnode_release_empty_bio_pair_buffers(BIO *bio) {
+  if (bio == NULL || bio->method != &methods_biop || !bio->init) {
+    return 0;
+  }
+  struct bio_bio_st *b = bio->ptr;
+  if (b == NULL || b->peer == NULL ||
+      b->peer->method != &methods_biop) {
+    return 0;
+  }
+  struct bio_bio_st *peer = b->peer->ptr;
+  if (peer == NULL || peer->peer != bio) {
+    return 0;
+  }
+
+  int released = 0;
+  struct bio_bio_st *sides[2] = {b, peer};
+  for (size_t i = 0; i < 2; ++i) {
+    struct bio_bio_st *side = sides[i];
+    if (side->len == 0 && side->buf != NULL) {
+      OPENSSL_free(side->buf);
+      side->buf = NULL;
+      side->offset = 0;
+      ++released;
+    }
+  }
+  return released;
+}
+
 size_t BIO_ctrl_get_read_request(BIO *bio) {
   return BIO_ctrl(bio, BIO_C_GET_READ_REQUEST, 0, NULL);
 }
