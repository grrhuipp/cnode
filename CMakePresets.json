{
  "version": 6,
  "configurePresets": [
    {
      "name": "musl",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/musl",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "VCPKG_TARGET_TRIPLET": "x64-linux-musl",
        "VCPKG_HOST_TRIPLET": "x64-linux-musl",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/musl.cmake",
        "CNODE_ENABLE_LTO": "OFF",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "musl-tests",
      "inherits": "musl",
      "cacheVariables": { "BUILD_TESTING": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "musl", "configurePreset": "musl", "targets": ["cnode"] },
    { "name": "musl-tests", "configurePreset": "musl-tests", "targets": ["cnode_tests"] }
  ],
  "testPresets": [
    {
      "name": "musl-tests",
      "configurePreset": "musl-tests",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
